# --- Obligatorias ---
# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Clave de ElevenLabs para la transcripción (elevenlabs.io → API Keys)
ELEVENLABS_API_KEY=
# Token de Vercel Blob (se crea solo al añadir un Blob Store al proyecto en Vercel)
BLOB_READ_WRITE_TOKEN=

# --- Modo personal (recomendado mientras la app sea solo para ti) ---
# Si APP_PASSWORD tiene valor, la web pide usuario y contraseña para entrar.
# Para hacerla pública, borra APP_PASSWORD.
APP_USER=egiaztatu
APP_PASSWORD=

# --- Opcionales ---
# Modelo de Claude (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo de transcripción de ElevenLabs (por defecto scribe_v1)
ELEVENLABS_STT_MODEL=scribe_v1

# Límites diarios por IP (por defecto: 5 subidas, 3 audios, 10 extracciones, 80 verificaciones)
LIMIT_UPLOAD_PER_DAY=5
LIMIT_TRANSCRIBE_PER_DAY=3
LIMIT_EXTRACT_PER_DAY=10
LIMIT_VERIFY_PER_DAY=80

# Solo si la app pasa a ser pública: Upstash Redis para que los límites se
# compartan entre todas las instancias de Vercel. En modo personal no hace falta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
